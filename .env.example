# Uppgifter som visas för besökare (ange de verkliga kontaktuppgifterna).
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Inkommande offertförfrågningar skickas till denna e-postadress.
CONTACT_INBOX_EMAIL=

# Resend: avsändaren måste finnas på en domän som är verifierad i Resend.
# Exempel: Komplett Flytt <offert@dindoman.se>
RESEND_FROM_EMAIL=

# Hemlig API-nyckel från https://resend.com/api-keys (lägg ALDRIG på GitHub).
RESEND_API_KEY=

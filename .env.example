# Publika kontaktuppgifter. Kan ändras utan att påverka mejl-API-nyckeln.
NEXT_PUBLIC_CONTACT_PHONE=07000001
NEXT_PUBLIC_CONTACT_EMAIL=info@gmail.com

# Inkorgen som tar emot offerter.
CONTACT_INBOX_EMAIL=info@gmail.com

# Kräver en verifierad avsändardomän i Resend. info@gmail.com kan INTE vara avsändare.
# Exempel efter verifiering av din egen domän: Komplett Flytt <offert@dindoman.se>
RESEND_FROM_EMAIL=

# Hemlig nyckel: fyll i ENDAST på servern / Vercel Environment Variables.
# Lägg aldrig in värdet i denna fil eller GitHub.
RESEND_API_KEY=
